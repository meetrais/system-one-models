# Copy to .env if you do not already have one, then set your TypeSafe API key.
TYPESAFE_API_KEY=your_api_key_here

# Optional Jev model identifier used by these samples.
TYPESAFE_DEFAULT_MODEL=jev-latest

# Opt out of DeepEval telemetry. Jev requests still use the network.
DEEPEVAL_TELEMETRY_OPT_OUT=YES
